# Copie ce fichier en .env et remplis-le. Ne le partage jamais : il contient tes mots de passe.

# Clé API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Ton adresse d'envoi. Avec Gmail : active la validation en 2 étapes, puis crée un
# « mot de passe d'application » sur https://myaccount.google.com/apppasswords
EMAIL_ADRESSE=
EMAIL_MOT_DE_PASSE=
EXPEDITEUR_NOM=

# Serveurs (Gmail par défaut). Outlook : smtp-mail.outlook.com / 587 / outlook.office365.com
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=465
IMAP_HOTE=imap.gmail.com

# Où recevoir les alertes (client intéressé, devis à faire…). Facultatif.
EMAIL_ALERTES=

# auto : l'agent envoie seul / validation : tu valides chaque email dans l'interface
MODE_ENVOI=auto
# oui : le serveur web lit la boîte toutes les X minutes, relance et prospecte une fois par jour
TOURNEE_AUTO=oui
MINUTES_ENTRE_LECTURES=15

# Garde-fous
ENVOIS_MAX_PAR_JOUR=20
RELANCES_MAX=2
JOURS_AVANT_RELANCE=4
PROSPECTS_PAR_TOURNEE=5

# Facultatif : scores Lighthouse sans limite
PAGESPEED_API_KEY=
